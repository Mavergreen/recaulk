# usage: shipyard-cmake -DRECIPES=<abs recipes.json> -P sdk-metadata-check.cmake
cmake_minimum_required(VERSION 3.19)
file(READ "${RECIPES}" j)
function(expect what got want)
  if(NOT got STREQUAL want)
    message(FATAL_ERROR "${what}: got '${got}', want '${want}'")
  endif()
endfunction()
string(JSON v GET "${j}" schema)
expect(schema "${v}" 1)
string(JSON v GET "${j}" sdk)
expect(sdk "${v}" MacOSX10.9)
string(JSON v GET "${j}" sdk_archive_sha256)
expect(sdk_archive_sha256 "${v}" fcf88ce8ff0dd3248b97f4eb81c7909f2cc786725de277f4d05a2b935cc49de0)
string(JSON n LENGTH "${j}" recipes)
expect("recipe count" "${n}" 1)
string(JSON v GET "${j}" recipes 0 id)
expect(id "${v}" foundation-array-generics-v1)
string(JSON v GET "${j}" recipes 0 header)
expect(header "${v}" System/Library/Frameworks/Foundation.framework/Versions/C/Headers/NSArray.h)
string(JSON v GET "${j}" recipes 0 sha256)
expect("header sha256" "${v}" 62c14ca4c2ab6fc0194328585cce9d18aab0b65338bd0aab2146ad9b0053c585)
string(JSON n LENGTH "${j}" recipes 0 aliases)
expect("alias count" "${n}" 1)
string(JSON v GET "${j}" recipes 0 aliases 0)
expect(alias "${v}" System/Library/Frameworks/Foundation.framework/Headers/NSArray.h)
string(JSON n LENGTH "${j}" recipes 0 replacements)
expect("replacement count" "${n}" 2)
string(JSON v GET "${j}" recipes 0 replacements 0 old)
expect("replacement 0 old" "${v}" "@interface NSArray : NSObject")
string(JSON v GET "${j}" recipes 0 replacements 0 new)
expect("replacement 0 new" "${v}" "@interface NSArray<__covariant ObjectType> : NSObject")
string(JSON v GET "${j}" recipes 0 replacements 1 old)
expect("replacement 1 old" "${v}" "@interface NSMutableArray : NSArray")
string(JSON v GET "${j}" recipes 0 replacements 1 new)
expect("replacement 1 new" "${v}" "@interface NSMutableArray<ObjectType> : NSArray<ObjectType>")

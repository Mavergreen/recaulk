# platform: host-agnostic -- cmake 3.19 or later, for string(JSON)
# spec: README.md "Profiles" -- a profile names a fixed set of recipe ids, every one in recipes.json and at most
#       one per header, since shipyard's materializer refuses two recipes on one header.
# usage: shipyard-cmake -DRECIPES=<abs recipes.json> -DPROFILES=<abs profiles.json> [-DREASON_FILE=<path>]
#          -P sdk-metadata-profiles-validate.cmake
#        exits 0 when the profiles have schema 1's shape; otherwise fails, writing the one-line reason to
#        REASON_FILE when given
cmake_minimum_required(VERSION 3.19)

function(refuse why)
  set(line "stage-sdk-metadata: ${PROFILES}: ${why}")
  if(REASON_FILE)
    file(WRITE "${REASON_FILE}" "${line}\n")
  endif()
  message(FATAL_ERROR "${line}")
endfunction()

function(only_keys obj where)
  string(JSON n LENGTH "${obj}")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${obj}" ${i})
      if(NOT k IN_LIST ARGN)
        refuse("${where} has unknown key '${k}'")
      endif()
    endforeach()
  endif()
  foreach(k IN LISTS ARGN)
    string(JSON t ERROR_VARIABLE err TYPE "${obj}" "${k}")
    if(err)
      refuse("${where} lacks '${k}'")
    endif()
  endforeach()
endfunction()

file(READ "${RECIPES}" rj)
file(READ "${PROFILES}" pj)
string(JSON t ERROR_VARIABLE err TYPE "${pj}")
if(err OR NOT t STREQUAL "OBJECT")
  refuse("is not a JSON object")
endif()
only_keys("${pj}" "the file" schema profiles)
string(JSON schema GET "${pj}" schema)
if(NOT schema STREQUAL "1")
  refuse("schema is ${schema}, want 1")
endif()

# recipe id -> header
string(JSON nr LENGTH "${rj}" recipes)
math(EXPR lr "${nr} - 1")
foreach(i RANGE ${lr})
  string(JSON id GET "${rj}" recipes ${i} id)
  string(JSON h GET "${rj}" recipes ${i} header)
  set("header_of_${id}" "${h}")
endforeach()

string(JSON t TYPE "${pj}" profiles)
if(NOT t STREQUAL "OBJECT")
  refuse("profiles is ${t}, want OBJECT")
endif()
string(JSON np LENGTH "${pj}" profiles)
if(np EQUAL 0)
  refuse("names no profile")
endif()
math(EXPR lp "${np} - 1")
foreach(i RANGE ${lp})
  string(JSON name MEMBER "${pj}" profiles ${i})
  if(NOT name MATCHES "^[a-z0-9][a-z0-9-]*$")
    refuse("profile name '${name}' is not lower-case letters, digits and hyphens")
  endif()
  string(JSON p GET "${pj}" profiles "${name}")
  # spec: the materializer design's "Layering" -- base is the one optional key
  string(JSON t ERROR_VARIABLE nobase TYPE "${p}" base)
  if(nobase)
    only_keys("${p}" "profile ${name}" description recipes)
  else()
    only_keys("${p}" "profile ${name}" description recipes base)
  endif()
  string(JSON t TYPE "${p}" description)
  if(NOT t STREQUAL "STRING")
    refuse("profile ${name}'s description is ${t}, want STRING")
  endif()
  string(JSON t TYPE "${p}" recipes)
  if(NOT t STREQUAL "ARRAY")
    refuse("profile ${name}'s recipes is ${t}, want ARRAY")
  endif()
  string(JSON n LENGTH "${p}" recipes)
  if(n EQUAL 0)
    refuse("profile ${name} names no recipe")
  endif()
  math(EXPR l "${n} - 1")
  set(ids)
  set(headers)
  foreach(k RANGE ${l})
    string(JSON id GET "${p}" recipes ${k})
    if(id IN_LIST ids)
      refuse("profile ${name} names ${id} twice")
    endif()
    if(NOT DEFINED "header_of_${id}")
      refuse("profile ${name} names ${id}, which recipes.json does not have")
    endif()
    set(h "${header_of_${id}}")
    list(FIND headers "${h}" at)
    if(NOT at EQUAL -1)
      list(GET ids ${at} other)
      refuse("profile ${name} names ${other} and ${id}, which both edit ${h}")
    endif()
    list(APPEND ids "${id}")
    list(APPEND headers "${h}")
  endforeach()
  set(ids_of_${name} "${ids}")
  list(APPEND names "${name}")
endforeach()

# spec: the materializer design's "Layering" -- a base names another profile, never forms a cycle, and its
#       profile carries every one of the base's recipe ids
foreach(name IN LISTS names)
  string(JSON p GET "${pj}" profiles "${name}")
  string(JSON t ERROR_VARIABLE noerr TYPE "${p}" base)
  if(noerr)
    continue()
  endif()
  if(NOT t STREQUAL "STRING")
    refuse("profile ${name}'s base is ${t}, want STRING")
  endif()
  set(seen "${name}")
  set(at "${name}")
  while(TRUE)
    string(JSON ap GET "${pj}" profiles "${at}")
    string(JSON nb ERROR_VARIABLE noerr GET "${ap}" base)
    if(noerr)
      break()
    endif()
    if(NOT nb IN_LIST names)
      refuse("profile ${at}'s base '${nb}' is not a profile")
    endif()
    if(nb IN_LIST seen)
      refuse("profile ${name}'s base chain returns to ${nb}")
    endif()
    list(APPEND seen "${nb}")
    set(at "${nb}")
  endwhile()
  string(JSON base GET "${p}" base)
  foreach(id IN LISTS ids_of_${base})
    if(NOT id IN_LIST ids_of_${name})
      refuse("profile ${name} lacks ${id} from its base ${base}")
    endif()
  endforeach()
endforeach()

# usage: shipyard-cmake -DRECIPES=<abs recipes.json> [-DREASON_FILE=<path>] -P sdk-metadata-validate.cmake
#        exits 0 when the recipe data has schema 1's shape; otherwise fails, writing the one-line
#        reason to REASON_FILE when given
cmake_minimum_required(VERSION 3.19)

function(refuse why)
  set(line "stage-sdk-metadata: ${RECIPES}: ${why}")
  if(REASON_FILE)
    file(WRITE "${REASON_FILE}" "${line}\n")
  endif()
  message(FATAL_ERROR "${line}")
endfunction()

function(only_keys obj where)
  string(JSON n LENGTH "${obj}")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${obj}" ${i})
      if(NOT k IN_LIST ARGN)
        refuse("${where} has unknown key '${k}'")
      endif()
    endforeach()
  endif()
  foreach(k IN LISTS ARGN)
    string(JSON t ERROR_VARIABLE err TYPE "${obj}" "${k}")
    if(err)
      refuse("${where} lacks '${k}'")
    endif()
  endforeach()
endfunction()

function(want_type got type where)
  if(NOT got STREQUAL type)
    refuse("${where} is ${got}, want ${type}")
  endif()
endfunction()

function(want_sha256 v where)
  string(LENGTH "${v}" len)
  if(NOT len EQUAL 64 OR NOT v MATCHES "^[0-9a-f]+$")
    refuse("${where} is not 64 lowercase hex digits")
  endif()
endfunction()

function(rel_path p where)
  if(p STREQUAL "" OR p MATCHES "^/" OR p MATCHES "(^|/)\\.\\.?(/|$)" OR p MATCHES "//" OR p MATCHES "/$")
    refuse("${where} '${p}' is not a plain path relative to the SDK")
  endif()
endfunction()

function(nonempty_string obj key where)
  string(JSON t TYPE "${obj}" "${key}")
  want_type("${t}" STRING "${where}.${key}")
  string(JSON v GET "${obj}" "${key}")
  if(v STREQUAL "")
    refuse("${where}.${key} is empty")
  endif()
  set(value "${v}" PARENT_SCOPE)
endfunction()

if(NOT EXISTS "${RECIPES}")
  refuse("no such file")
endif()
file(READ "${RECIPES}" j)
string(JSON t ERROR_VARIABLE err TYPE "${j}")
if(err OR NOT t STREQUAL "OBJECT")
  refuse("not a JSON object")
endif()
only_keys("${j}" "the top level" schema sdk sdk_archive_sha256 recipes)

string(JSON t TYPE "${j}" schema)
string(JSON v GET "${j}" schema)
if(NOT t STREQUAL "NUMBER" OR NOT v STREQUAL "1")
  refuse("schema is '${v}', this stager knows only 1")
endif()
nonempty_string("${j}" sdk "the top level")
if(NOT value STREQUAL "MacOSX10.9")
  refuse("sdk is '${value}', want MacOSX10.9")
endif()
nonempty_string("${j}" sdk_archive_sha256 "the top level")
want_sha256("${value}" sdk_archive_sha256)

string(JSON t TYPE "${j}" recipes)
want_type("${t}" ARRAY recipes)
string(JSON n LENGTH "${j}" recipes)
if(n EQUAL 0)
  refuse("recipes is empty")
endif()
math(EXPR last "${n} - 1")
set(ids)
foreach(i RANGE ${last})
  set(w "recipes[${i}]")
  string(JSON t TYPE "${j}" recipes ${i})
  want_type("${t}" OBJECT "${w}")
  string(JSON r GET "${j}" recipes ${i})
  only_keys("${r}" "${w}" id header sha256 aliases replacements)

  nonempty_string("${r}" id "${w}")
  if(NOT value MATCHES "^[a-z0-9][a-z0-9.-]*$")
    refuse("${w}.id '${value}' is not lowercase letters, digits, '.' and '-'")
  endif()
  if(value IN_LIST ids)
    refuse("${w}.id '${value}' is not unique")
  endif()
  list(APPEND ids "${value}")

  nonempty_string("${r}" header "${w}")
  rel_path("${value}" "${w}.header")
  nonempty_string("${r}" sha256 "${w}")
  want_sha256("${value}" "${w}.sha256")

  string(JSON t TYPE "${r}" aliases)
  want_type("${t}" ARRAY "${w}.aliases")
  string(JSON na LENGTH "${r}" aliases)
  if(na GREATER 0)
    math(EXPR al "${na} - 1")
    foreach(a RANGE ${al})
      string(JSON t TYPE "${r}" aliases ${a})
      want_type("${t}" STRING "${w}.aliases[${a}]")
      string(JSON v GET "${r}" aliases ${a})
      rel_path("${v}" "${w}.aliases[${a}]")
    endforeach()
  endif()

  string(JSON t TYPE "${r}" replacements)
  want_type("${t}" ARRAY "${w}.replacements")
  string(JSON nr LENGTH "${r}" replacements)
  if(nr EQUAL 0)
    refuse("${w}.replacements is empty")
  endif()
  math(EXPR rl "${nr} - 1")
  foreach(k RANGE ${rl})
    set(rw "${w}.replacements[${k}]")
    string(JSON t TYPE "${r}" replacements ${k})
    want_type("${t}" OBJECT "${rw}")
    string(JSON rep GET "${r}" replacements ${k})
    only_keys("${rep}" "${rw}" old new)
    nonempty_string("${rep}" old "${rw}")
    set(old "${value}")
    nonempty_string("${rep}" new "${rw}")
    if(value STREQUAL old)
      refuse("${rw} replaces '${old}' with itself")
    endif()
  endforeach()
endforeach()
